{
	"$schema": "https://json.schemastore.org/launchsettings.json",
	"iisSettings": {
		"windowsAuthentication": false,
		"anonymousAuthentication": true,
		"iisExpress": {
			"applicationUrl": "http://localhost:53864",
			"sslPort": 44340
		}
	},
	"profiles": {
		"app": {
			"commandName": "Project",
			"dotnetRunMessages": true,
			"launchBrowser": false,
			"launchUrl": "swagger",
			"applicationUrl": "https://localhost:7262;http://localhost:5135",
			"environmentVariables": {
				"ASPNETCORE_ENVIRONMENT": "Development"
			}
		},
		"app, skip startup": {
			"commandName": "Project",
			"dotnetRunMessages": true,
			"launchBrowser": false,
			"launchUrl": "swagger",
			"applicationUrl": "https://localhost:7262;http://localhost:5135",
			"environmentVariables": {
				"ASPNETCORE_ENVIRONMENT": "Development",
				"Startup:IgnoreStartupActions": "true"
			}
		},
		"watch": {
			"commandName": "Executable",
			"executablePath": "dotnet",
			"workingDirectory": "$(ProjectDir)",
			"commandLineArgs": "watch --non-interactive run",
			"launchBrowser": false,
			"environmentVariables": {
				"ASPNETCORE_ENVIRONMENT": "Development",
				"ASPNETCORE_HTTPS_PORT": "7262"
			},
			"dotnetRunMessages": true,
			"applicationUrl": "https://localhost:7262;http://localhost:5135"
		},
		"watch, skip startup": {
			"commandName": "Executable",
			"executablePath": "dotnet",
			"workingDirectory": "$(ProjectDir)",
			"commandLineArgs": "watch --non-interactive run",
			"environmentVariables": {
				"ASPNETCORE_ENVIRONMENT": "Development",
				"ASPNETCORE_HTTPS_PORT": "7262",
				"Startup:IgnoreStartupActions": "true"
			},
			"launchBrowser": false,
			"dotnetRunMessages": true,
			"applicationUrl": "https://localhost:7262;http://localhost:5135"
		}
	}
}
