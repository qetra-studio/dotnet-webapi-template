{
	"Serilog": {
		"MinimumLevel": {
			"Default": "Information"
		}
	},
	"Dependencies": {
		"Database": {
			"Connection": {
				"Retries": 3,
				"Timeout": 10,
				"Additional": ["MultipleActiveResultSets=True"]
			},
			"Entities": {
				"Validation": "Required"
			}
		}
	},
	"Startup": {
		"IgnoreStartupActions": false
	}
}
